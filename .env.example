# Zkopiruj na .env a vypln. .env je v .gitignore.

# UDID telefonu:  xcrun devicectl list devices
UDID=00000000-0000000000000000

# Postaveny testovaci bundle:
#   find ~/Library/Developer/Xcode/DerivedData -name "*.xctestrun"
XCTESTRUN=~/Library/Developer/Xcode/DerivedData/WebDriverAgent-XXXX/Build/Products/WebDriverAgentRunner_iphoneosXX.X-arm64.xctestrun

# IP telefonu na tve siti. WDA ji vypise pri startu jako ServerURLHere.
PHONE_HOST=192.168.0.0
